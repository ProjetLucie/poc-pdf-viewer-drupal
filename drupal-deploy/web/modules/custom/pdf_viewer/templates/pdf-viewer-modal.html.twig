{#
/**
 * @file
 * Modal-only template for the PDF viewer component (no built-in trigger button).
 *
 * Use this template when you want to control the trigger yourself.
 * Any element anywhere on the page can open this modal by having:
 *   - data-open-pdf-viewer="{{ viewer_id }}"  ← targets this modal
 *   - data-pdf="/path/to/document.pdf"        ← document to load
 *
 * Available variables:
 * - viewer_id: Unique string scoping this instance (auto-generated if omitted).
 *
 * Usage example (render array):
 * @code
 * $build['viewer'] = ['#theme' => 'pdf_viewer_modal', '#viewer_id' => 'my-viewer'];
 * @endcode
 *
 * Trigger example (any element, anywhere):
 * @code
 * <a href="#" data-open-pdf-viewer="my-viewer" data-pdf="/files/doc.pdf">
 *   Open PDF
 * </a>
 * @endcode
 *
 * @ingroup themeable
 */
#}

{{ attach_library('pdf_viewer/pdf_viewer') }}

{# ─── Modal only — no trigger button ─────────────────────────────────────── #}

<div
  class="pdf-modal-overlay"
  data-viewer-id="{{ viewer_id }}"
  role="dialog"
  aria-modal="true"
  aria-label="Visionneuse PDF"
  aria-hidden="true"
>
  <div class="pdf-modal">

    <div class="pdf-modal-header">
      <div class="pdf-controls">
        <button class="pdf-prev" type="button" title="Page précédente" disabled>
          ← Précédent
        </button>

        <span class="pdf-page-indicator" aria-live="polite">…</span>

        <button class="pdf-next" type="button" title="Page suivante" disabled>
          Suivant →
        </button>

        <button class="pdf-zoom-out" type="button" title="Réduire le zoom">
          − Zoom
        </button>

        <button class="pdf-zoom-in" type="button" title="Agrandir le zoom">
          + Zoom
        </button>

        <button class="pdf-rotate-ccw" type="button" title="Rotation anti-horaire">
          ↺
        </button>

        <button class="pdf-rotate-cw" type="button" title="Rotation horaire">
          ↻
        </button>
      </div>

      <button class="pdf-modal-close" type="button" title="Fermer la visionneuse">
        ✕ Fermer
      </button>
    </div>

    <div class="pdf-modal-body">
      <canvas data-viewer-id="{{ viewer_id }}"></canvas>
    </div>

  </div>
</div>
