{#
/**
 * @file
 * Secure PDF viewer — modal only, external trigger.
 *
 * Available variables:
 * - fid:       Drupal managed file ID (required).
 * - viewer_id: Unique string scoping this instance (auto-generated if omitted).
 *
 * Trigger example:
 * @code
 * <a href="#" data-open-pdf-viewer-secure="my-viewer">Voir le document</a>
 * @endcode
 *
 * @ingroup themeable
 */
#}

{{ attach_library('pdf_viewer_secure/pdf_viewer_secure') }}

<div
  class="pvs-modal-overlay"
  data-viewer-id="{{ viewer_id }}"
  data-fid="{{ fid }}"
  role="dialog"
  aria-modal="true"
  aria-label="Visionneuse PDF"
  aria-hidden="true"
>
  <div class="pvs-modal">

    <header class="pvs-modal-header">
      <span class="pvs-doc-title">Document</span>

      <div class="pvs-nav-group">
        <button class="pvs-prev" type="button" title="Page précédente" disabled>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <span class="pvs-page-indicator" aria-live="polite">— / —</span>
        <button class="pvs-next" type="button" title="Page suivante" disabled>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>

      <button class="pvs-modal-close" type="button" title="Fermer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        Fermer
      </button>
    </header>

    <div class="pvs-modal-body">
      <canvas class="pvs-canvas" data-viewer-id="{{ viewer_id }}"></canvas>
    </div>

    <aside class="pvs-sidebar">
      <button class="pvs-zoom-in" type="button" title="Agrandir le zoom">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
      </button>
      <button class="pvs-zoom-out" type="button" title="Réduire le zoom">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
      </button>
      <div class="pvs-sidebar-sep"></div>
      <button class="pvs-rotate-ccw" type="button" title="Rotation anti-horaire">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.12"/></svg>
      </button>
      <button class="pvs-rotate-cw" type="button" title="Rotation horaire">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-.49-4.12"/></svg>
      </button>
    </aside>

  </div>
</div>
